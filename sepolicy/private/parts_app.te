app_domain(parts_app)

# The app writes uncategorized (s0) sysfs nodes (thermal sconfig, qcom-battery
# charging control). The MLS write constraint requires the object to be
# trusted for that, so mark the sysfs types it writes mlstrustedobject.
typeattribute sysfs_thermal mlstrustedobject;

binder_use(parts_app)

hal_client_domain(parts_app, hal_touchfeature_xiaomi)
hal_client_domain(parts_app, vendor_hal_displayfeature_xiaomi)

binder_call(parts_app, hal_touchfeature_xiaomi)
binder_call(parts_app, vendor_hal_displayfeature_xiaomi)

allow parts_app {
  activity_service
  activity_task_service
  audio_service
  audioserver_service
  autofill_service
  batteryproperties_service
  batterystats_service
  content_capture_service
  game_service
  gpu_service
  hint_service
  media_session_service
  netstats_service
  trust_service
  sensorservice_service
  storagestats_service
  surfaceflinger_service
  vendor_perf_service
  virtual_device_service
  vibrator_manager_service
}:service_manager find;

allow parts_app {
  hal_touchfeature_xiaomi_hwservice
  vendor_hal_displayfeature_xiaomi_hwservice
}:hwservice_manager find;

allow parts_app sysfs_tp_fodstatus:dir r_dir_perms;
allow parts_app sysfs_tp_fodstatus:file r_file_perms;

allow parts_app sysfs_thermal:dir r_dir_perms;
allow parts_app sysfs_thermal:file rw_file_perms;
